{
  "name": "identichain",
  "version": "1.0.0",
  "description": "Refugee-owned, cross-border, AI-powered digital identity and document vault",
  "main": "backend/server.js",
  "scripts": {
    "build": "cd frontend && npm install && npm run build",
    "start": "node backend/server.js",
    "seed": "node backend/seed.js",
    "setup": "npm --prefix backend install && npm --prefix frontend install && npm --prefix frontend run build",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend start",
    "dev:frontend": "npm --prefix frontend run dev"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb-memory-server": "^9.2.0",
    "mongoose": "^8.3.1",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.3",
    "uuid": "^9.0.1"
  },
  "keywords": [
    "digital-identity",
    "refugee",
    "document-vault",
    "sha256",
    "ai-triage",
    "cross-border"
  ],
  "author": "IdentiChain Team",
  "license": "MIT"
}
